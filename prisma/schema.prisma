generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String?  @db.Text
  displayName      String?  @db.Text
  username         String?  @unique @db.Text
  firstName        String?  @db.Text
  lastName         String?  @db.Text
  university       String?  @db.Text
  major            String?  @db.Text
  profilePhotoUrl  String?  @db.Text
  profileCompleted Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks         Task[]
  focusSessions FocusSession[]
  aiChats       AIChatConversation[]
  settings      UserSettings?
}

model Task {
  id                 String   @id @default(uuid())
  userId             String
  title              String   @db.Text
  description        String   @default("") @db.Text
  status             String   @default("pending") @db.Text
  priority           String   @default("medium") @db.Text
  category           String   @default("") @db.Text
  course             String   @default("") @db.Text
  taskLink           String?  @db.Text
  attachmentName     String?  @db.Text
  attachmentMimeType String?  @db.Text
  attachmentDataUrl  String?  @db.Text
  startTime          DateTime
  endTime            DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  focusSessions FocusSession[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model FocusSession {
  id              String   @id @default(uuid())
  userId          String
  taskId          String?
  durationMinutes Int
  startedAt       DateTime
  completedAt     DateTime
  notes           String   @default("") @db.Text
  createdAt       DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([userId, completedAt])
}

model AIChatConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New Conversation") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages AIChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model AIChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   @db.Text // "user" or "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AIChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  notificationRules   Json?    @default("{}")
  calendarPreferences Json?    @default("{}")
  focusTimerDefaults  Json?    @default("{}")
  privacyControls     Json?    @default("{}")
  appearanceSettings  Json?    @default("{}")
  aiPreferences       Json?    @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
